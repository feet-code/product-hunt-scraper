# Single-key setup remains supported.
GEMINI_API_KEY=
# Optional comma-separated pool of collaborator-owned Gemini keys. When present,
# generation rotates fairly across keys and keeps separate persisted RPM/RPD/cooldowns.
# Only pool keys that are independently authorized for this shared project/workflow.
GEMINI_API_KEYS=
GEMINI_MODELS=gemini-3.8-flash,gemini-3.7-flash,gemini-3.6-flash,gemini-3.5-flash,gemini-3-flash,gemini-2.5-flash

# Required only with --publish.
MAGIC_CATALOG_URL=https://magic-catalog.cloudwebsites.workers.dev
MAGIC_CATALOG_IMPORT_TOKEN=

# Identifies the crawler in Product Hunt and external-site logs.
SCRAPER_USER_AGENT=MagicCatalogResearchBot/1.0 (+https://magic-catalog.cloudwebsites.workers.dev)


# Local per-key/per-model request accounting used by the Gemini key pool.
# Set these to the limits that apply to each independently authorized key/project.
GEMINI_RPD=20
GEMINI_RPM=5
GEMINI_TPM=25000
GEMINI_QUOTA_SCOPE=default-project
# Optional: same absolute path in BOTH repos. Default: ~/.magic-catalog/quotas.sqlite3
# MAGIC_QUOTA_DB=
# Same scope across importers using the same Cloudflare account.
MAGIC_WRITE_SCOPE=cloudflare-account
